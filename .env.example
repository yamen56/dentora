# ──────────────────────────────────────────────────────────────
# Dentora — environment variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local dev: point both at your local Postgres (same value).
# Production (Neon/Supabase): set DATABASE_URL to the *pooled* connection string
# (Neon's "-pooler" host) and DIRECT_URL to the *direct* connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dentora?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dentora?schema=public"

# ── NextAuth ──────────────────────────────────────────────────
# The canonical URL of your site (no trailing slash).
# Dev: http://localhost:3000  ·  Prod: https://your-app.vercel.app (or your domain)
NEXTAUTH_URL="http://localhost:3000"
# Secret used to encrypt JWT session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ── Cloudinary (video + PDF storage, signed delivery) ─────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Optional: an unsigned upload preset if you prefer preset-based uploads
CLOUDINARY_UPLOAD_PRESET="dentora_unsigned"
# Public cloud name exposed to the browser (same value as CLOUDINARY_CLOUD_NAME)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default admin seeded by `prisma db seed`
SEED_ADMIN_EMAIL="admin@dentora.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
