# ──────────────────────────────────────────────────────────────
# Why Medicine — environment variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local dev: point both at your local Postgres (same value).
# Production (Neon/Supabase): set DATABASE_URL to the *pooled* connection string
# (Neon's "-pooler" host) and DIRECT_URL to the *direct* connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whymedicine?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/whymedicine?schema=public"

# ── NextAuth ──────────────────────────────────────────────────
# The canonical URL of your site (no trailing slash).
# Dev: http://localhost:3000  ·  Prod: https://your-app.vercel.app (or your domain)
NEXTAUTH_URL="http://localhost:3000"
# Secret used to encrypt JWT session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ── Cloudinary (video + PDF storage, signed delivery) ─────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Optional: an unsigned upload preset if you prefer preset-based uploads
CLOUDINARY_UPLOAD_PRESET="whymedicine_unsigned"
# Public cloud name exposed to the browser (same value as CLOUDINARY_CLOUD_NAME)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ── Bunny.net Stream (video hosting; preferred over Cloudinary when set) ──
# Create a Stream library at https://dash.bunny.net → Stream. All four values
# are in the library's settings. Videos upload browser → Bunny via TUS and
# play back as HLS. When these are unset, uploads fall back to Cloudinary.
BUNNY_STREAM_LIBRARY_ID=""
# The library's "API key" (Stream library > API), NOT the account API key
BUNNY_STREAM_API_KEY=""
# The library's CDN hostname, e.g. vz-abc12345-678.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=""
# Optional but recommended: enable "Token Authentication" in the library's
# security settings and paste its key here so playback URLs are signed + expire.
BUNNY_STREAM_TOKEN_KEY=""

# ── SEO / canonical site URL (no trailing slash) ──────────────
# Used for sitemap.xml, robots.txt, canonical tags and Open Graph URLs.
# Set to the real domain once purchased, e.g. https://whymedicine.net
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default admin seeded by `prisma db seed`
SEED_ADMIN_EMAIL="admin@whymedicine.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
GOOGLE_SITE_VERIFICATION=""
